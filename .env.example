# ===================================================================
#  CẤU HÌNH CHATBOT 3 TẦNG (Rule → JEV → LLM) — copy sang .env
#  cp .env.example .env
#  .env đã nằm trong .gitignore, KHÔNG commit lên GitHub.
# ===================================================================

# --- Chatbot local (FastAPI) ---
# Địa chỉ đầy đủ tới endpoint /api/chat của chatbot-service.
# Đổi port nếu bạn chạy uvicorn với --port khác 8000.
CHATBOT_API_URL=http://localhost:8000/api/chat

# Timeout kết nối (ms). Tầng 1/2 nhanh, tầng 3 (Qwen 7B) có thể vài giây.
CHATBOT_CONNECT_MS=5000
CHATBOT_TIMEOUT_MS=65000

# --- Database (nếu muốn override) ---
# DB_NAME=fashionecom
# DB_USER=root
# DB_PASS=123456